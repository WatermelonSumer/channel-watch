# Shared development configuration for the workspace.
# Copy to .env in the repository root and adjust values as needed.

API_HOST=127.0.0.1
API_PORT=4176
WEB_HOST=127.0.0.1
WEB_PORT=5173
WEB_HTTP_PORT=8080

# Direct IP Docker deployment: set WEB_HTTP_PORT=80 so http://<server-ip>/ works.
# When the API runs on the Docker host, point nginx to host.docker.internal.
# WEB_HTTP_PORT=80
# API_PROXY_TARGET=http://host.docker.internal:4176

# Optional. Defaults to http://${API_HOST}:${API_PORT}.
# API_PROXY_TARGET=http://127.0.0.1:4176

API_DATA_DIR=data
# API_DB_PATH=data/radar.db

BALANCE_RATE_SCAN_INTERVAL=60
AUTO_PROBE_INTERVAL=60
RATE_PROBE_INTERVAL=60
MODEL_MONITOR_INTERVAL=60
